# Auto detect text files
* text=auto

# JavaScript
*.js text eol=lf

# HTML
*.html text eol=lf

# CSS
*.css text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Icons
*.ico binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Documents
*.pdf binary

# Line endings
*.sh text eol=lf
*.bat text eol=crlf

# Keep generated QR images as binary
generated/*.png binary
